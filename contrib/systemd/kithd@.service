[Unit]
Description=Kith mailbox daemon for %i
# %i is the instance name — the part after '@' in the unit name.
# Example: systemctl enable kithd@alice.service  →  %i = alice
Documentation=https://github.com/markAtwood/kith
After=network-online.target
# No Requires=tailscaled.service: per-user tailscaled instances may not be present
# as a system unit; callers who run a per-user tailscaled should add an
# override with: systemctl edit kithd@.service

[Service]
# ---- Process type ----
# kithd does not call sd_notify; use simple so systemd considers the service
# ready as soon as the process starts.
Type=simple

# ---- Identity ----
# Each instance runs as its own user (kith-<username>) for process isolation.
# Create users before enabling: useradd -r -s /sbin/nologin -d /var/lib/kithd/%i kith-%i
User=kith-%i
# All instances share a single group for shared socket access if needed.
Group=kithd
# Files created by kithd (kith.db, kith.key, kith.crt) are owner-only (0o600/0o700).
UMask=0077

# ---- Configuration (via environment) ----
# Authoritative env var reference: crates/kithd/src/config.rs (Config::from_env)
# Only key variables are listed here; see config.rs for all KITHD_* variables and defaults.
# Each instance stores data in a separate subdirectory, providing full isolation.
Environment="KITHD_DATA_DIR=/var/lib/kithd/%i"

Environment="KITHD_TAILSCALED_SOCKET=/var/run/tailscale/tailscaled.sock"
# Tailscale LocalAPI socket; must be accessible by the kith-%i user.

Environment="KITHD_PORT=443"
# HTTPS listener port; kithd binds only to Tailscale virtual interfaces.

# kithd auto-detects owner identity from Tailscale if this is empty.
# For multi-user hosts, set per-instance via a drop-in override to avoid
# ambiguity when multiple users share the same tailscaled socket:
#   systemctl edit kithd@alice.service  →  add:
#   [Service]
#   Environment="KITHD_OWNER_ID=<alice-tailscale-user-id>"
# Get the value with: tailscale status --json | jq -r .Self.UserID
Environment="KITHD_OWNER_ID="

# Per-instance log filtering; %i is substituted by systemd at runtime.
Environment="RUST_LOG=kithd=info,kith_peer=info"
# Logging level. kithd writes JSON to stderr (captured by journald) when not a TTY.

# ---- Executable ----
ExecStart=/usr/local/bin/kithd

# ---- Restart policy ----
Restart=on-failure
# Wait 5 s before restarting to avoid rapid loops on persistent startup failures.
RestartSec=5

# ---- Graceful shutdown ----
# kithd handles SIGTERM with a graceful drain (up to 10 s); allow 15 s before
# systemd sends SIGKILL, giving the in-flight connection drain room to finish.
TimeoutStopSec=15

# ---- Security hardening ----
# Prevent privilege escalation via setuid/setgid binaries.
NoNewPrivileges=yes

# /usr, /boot, /lib are read-only; kithd cannot modify system libraries.
ProtectSystem=strict

# Exception to ProtectSystem: this instance's data directory must be writable.
ReadWritePaths=/var/lib/kithd/%i

# /home, /root, /run/user are inaccessible; kithd has no business reading user homes.
ProtectHome=yes

# kithd does not use /tmp, but a private namespace prevents cross-process temp access.
PrivateTmp=yes

# AF_UNIX: Tailscale LocalAPI socket; AF_INET/INET6: HTTPS listener on Tailscale IPs.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# No capabilities needed; kithd binds to Tailscale virtual interfaces (user-space port).
CapabilityBoundingSet=
# Complements CapabilityBoundingSet=: no ambient capabilities either.
AmbientCapabilities=

# Raise file descriptor limit for the event loop + SQLite connections.
LimitNOFILE=65536

# ---- Logging ----
StandardOutput=journal
StandardError=journal
# Filter logs: journalctl -u kithd@%i -f
SyslogIdentifier=kithd-%i

[Install]
WantedBy=multi-user.target
